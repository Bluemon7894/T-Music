{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null && $code.length === 6",
        ".write": "auth != null && !newData.exists() && !data.child('members').exists()",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid || data.child('ownerUid').val() === auth.uid || (root.child('rooms').child($code).child('members').child(auth.uid).exists() && root.child('rooms').child($code).child('members').child(data.child('hostUid').val()).child('listening').val() !== true))",
          ".validate": "newData.hasChildren(['hostUid', 'name', 'controlMode', 'createdAt'])",
          "hostUid": {
            ".validate": "newData.isString()"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "controlMode": {
            ".validate": "newData.val() === 'host' || newData.val() === 'everyone'"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "ownerUid": {
            ".validate": "newData.isString()"
          },
          "expiresAt": {
            ".validate": "newData.isNumber()"
          },
          "sounds": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "members": {
          ".write": "auth != null && root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('meta').exists() && !root.child('rooms').child($code).child('kicked').child($uid).exists()",
            ".validate": "newData.hasChildren(['name', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "photo": {
              ".validate": "newData.isString() && newData.val().length <= 20000"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "listening": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "modes": {
          ".write": "auth != null && (root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid || (root.child('rooms').child($code).child('meta/controlMode').val() === 'everyone' && root.child('rooms').child($code).child('members').child(auth.uid).exists()))",
          "repeat": {
            ".validate": "newData.val() === 'off' || newData.val() === 'all' || newData.val() === 'one'"
          },
          "shuffle": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "kicked": {
          "$uid": {
            ".write": "auth != null && root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid",
            ".validate": "newData.isBoolean()"
          }
        },
        "lyrics": {
          "$track": {
            ".write": "auth != null && (root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid || (root.child('rooms').child($code).child('meta/controlMode').val() === 'everyone' && root.child('rooms').child($code).child('members').child(auth.uid).exists()))",
            ".validate": "newData.hasChildren(['data', 'by', 'at']) && $track.matches(/^[A-Za-z0-9_-]{11}$/)",
            "data": {
              ".validate": "newData.isString() && newData.val().length <= 200000"
            },
            "offset": {
              ".validate": "newData.isNumber()"
            },
            "by": {
              ".validate": "newData.val() === auth.uid"
            },
            "at": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "playback": {
          ".write": "auth != null && (root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid || (root.child('rooms').child($code).child('meta/controlMode').val() === 'everyone' && root.child('rooms').child($code).child('members').child(auth.uid).exists()) || (root.child('rooms').child($code).child('members').child(auth.uid).exists() && newData.child('playing').val() === false))",
          ".validate": "newData.hasChildren(['track', 'positionMs', 'playing', 'updatedAt', 'rev', 'by'])",
          "track": {
            "id": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{11}$/)"
            }
          },
          "positionMs": {
            ".validate": "newData.isNumber()"
          },
          "playing": {
            ".validate": "newData.isBoolean()"
          },
          "updatedAt": {
            ".validate": "newData.val() === now"
          },
          "rev": {
            ".validate": "newData.isNumber()"
          },
          "by": {
            ".validate": "newData.val() === auth.uid"
          },
          "ending": {
            ".validate": "newData.isBoolean()"
          }
        },
        "radio": {
          ".write": "auth != null && (root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid || (root.child('rooms').child($code).child('meta/controlMode').val() === 'everyone' && root.child('rooms').child($code).child('members').child(auth.uid).exists()))",
          ".validate": "newData.hasChildren(['id', 'kind', 'name', 'band', 'freq', 'by', 'at'])",
          "id": {
            ".validate": "newData.isString() && newData.val().length <= 80 && newData.val().matches(/^(rb|yt):/)"
          },
          "kind": {
            ".validate": "newData.val() === 'station' || newData.val() === 'youtube'"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "band": {
            ".validate": "newData.val() === 'FM' || newData.val() === 'AM'"
          },
          "freq": {
            ".validate": "newData.isNumber()"
          },
          "url": {
            ".validate": "newData.isString() && newData.val().length <= 500 && newData.val().matches(/^https?:\\/\\//)"
          },
          "videoId": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{11}$/)"
          },
          "logo": {
            ".validate": "newData.isString() && newData.val().length <= 500 && newData.val().matches(/^https:\\/\\//)"
          },
          "hls": {
            ".validate": "newData.isBoolean()"
          },
          "by": {
            ".validate": "newData.val() === auth.uid"
          },
          "at": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        },
        "queue": {
          ".write": "auth != null && root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid",
          "$key": {
            ".write": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists() && root.child('rooms').child($code).child('meta/controlMode').val() === 'everyone'",
            ".validate": "newData.hasChildren(['track', 'by', 'byName'])",
            "track": {
              "id": {
                ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{11}$/)"
              }
            },
            "by": {
              ".validate": "newData.val() === auth.uid"
            },
            "byName": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "order": {
              ".validate": "newData.isNumber()"
            }
          }
        },
        "chat": {
          ".indexOn": [
            "at"
          ],
          "$id": {
            ".write": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists() && ((newData.exists() && !data.exists()) || (!newData.exists() && (data.child('uid').val() === auth.uid || data.child('at').val() < now - 86400000)))",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 'at'])",
            "uid": {
              ".validate": "newData.val() === auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300"
            },
            "at": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "photo": {
          ".validate": "newData.isString() && newData.val().length <= 20000"
        },
        "friendCode": {
          ".validate": "newData.isString() && root.child('friendCodes').child(newData.val()).val() === auth.uid"
        },
        "sharing": {
          "online": {
            ".validate": "newData.isBoolean()"
          },
          "track": {
            ".validate": "newData.isBoolean()"
          },
          "playlists": {
            ".validate": "newData.isBoolean()"
          },
          "topTracks": {
            ".validate": "newData.isBoolean()"
          },
          "time": {
            ".validate": "newData.isBoolean()"
          },
          "artists": {
            ".validate": "newData.isBoolean()"
          },
          "genres": {
            ".validate": "newData.isBoolean()"
          },
          "asked": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          },
          "lastSeen": {
            ".validate": "newData.isBoolean()"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "friendProfiles": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('friends').child(auth.uid).child($uid).exists())",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "friendCodes": {
      "$code": {
        ".read": "auth != null && $code.length === 8",
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))"
      }
    },
    "friendRequests": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        ".write": "auth != null && auth.uid === $to && !newData.exists()",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || (auth.uid === $to && !newData.exists()))",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "photo": {
            ".validate": "newData.isString() && newData.val().length <= 20000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "friends": {
      "$owner": {
        ".read": "auth != null && auth.uid === $owner",
        "$other": {
          ".write": "auth != null && ((!newData.exists() && (auth.uid === $owner || auth.uid === $other)) || (newData.exists() && auth.uid === $owner && root.child('friendRequests').child($owner).child($other).exists()) || (newData.exists() && auth.uid === $other && root.child('friendRequests').child($other).child($owner).exists()) || (newData.exists() && auth.uid === $owner && root.child('friendMoves').child($owner).child($other).exists()) || (newData.exists() && auth.uid === $other && root.child('friendMoves').child($other).child($owner).exists()))"
        }
      }
    },
    "friendMoves": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        ".write": "auth != null && auth.uid === $to && !newData.exists()",
        "$friend": {
          ".write": "auth != null && ((auth.uid === $to && !newData.exists()) || (newData.isString() && newData.val() === auth.uid && root.child('friends').child(auth.uid).child($friend).exists()))"
        }
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('friends').child(auth.uid).child($uid).exists())",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "invites": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        ".write": "auth != null && auth.uid === $to && !newData.exists()",
        "$id": {
          ".write": "auth != null && ((newData.exists() && newData.child('code').isString() && root.child('rooms').child(newData.child('code').val()).child('members').child(auth.uid).exists() && root.child('rooms').child(newData.child('code').val()).child('members').child($to).exists()) || (newData.exists() && root.child('friends').child($to).child(auth.uid).exists()) || (!newData.exists() && (auth.uid === $to || data.child('from').val() === auth.uid)))",
          ".validate": "newData.hasChildren(['from', 'code', 'at'])",
          "from": {
            ".validate": "newData.val() === auth.uid"
          },
          "fromName": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "fromPhoto": {
            ".validate": "newData.isString() && newData.val().length <= 20000"
          },
          "code": {
            ".validate": "newData.isString() && newData.val().length === 6"
          },
          "roomName": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "at": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "wakeOwners": {
      "$secret": {
        ".write": "auth != null && $secret.length >= 20 && $secret.length <= 64 && ((!data.exists() && newData.val() === auth.uid) || (!newData.exists() && data.val() === auth.uid))"
      }
    },
    "friendWake": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('friends').child($uid).child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid",
        "$secret": {
          ".validate": "newData.isBoolean() && $secret.length >= 20 && $secret.length <= 64"
        }
      }
    },
    "wakeBox": {
      "$secret": {
        ".read": "$secret.length >= 20",
        ".write": "auth != null && !newData.exists() && root.child('wakeOwners').child($secret).val() === auth.uid",
        "$id": {
          ".write": "auth != null && root.child('wakeOwners').child($secret).exists() && ((newData.exists() && root.child('friends').child(root.child('wakeOwners').child($secret).val()).child(auth.uid).exists()) || (!newData.exists() && (root.child('wakeOwners').child($secret).val() === auth.uid || data.child('from').val() === auth.uid)))",
          ".validate": "newData.hasChildren(['from', 'code', 'at'])",
          "from": {
            ".validate": "newData.val() === auth.uid"
          },
          "fromName": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "code": {
            ".validate": "newData.isString() && newData.val().length === 6"
          },
          "roomName": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "at": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "pushTokens": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "$token": {
          ".validate": "$token.length >= 20 && $token.length <= 300 && newData.isNumber()"
        }
      }
    }
  }
}
